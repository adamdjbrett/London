<!DOCTYPE html>
<html lang="{{metadata.language}}">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>{{#if title}}{{title}} | {{metadata.title}}{{else}}{{metadata.title}}{{/if}}</title>
  <meta name="HandheldFriendly" content="True" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{#if description}}{{description}}{{else}}{{metadata.description}}{{/if}}" />
  <link rel="stylesheet" type="text/css" href="/assets/built/screen.css" />
</head>
<body class="{{#if bodyClass}}{{bodyClass}}{{else}}is-head-left-logo{{/if}}">
<div class="site-wrapper">

  <header id="gh-head" class="gh-head gh-outer">
    <div class="gh-head-inner gh-inner">
      <div class="gh-head-brand">
        <div class="gh-head-brand-wrapper">
          <a class="gh-head-logo" href="{{metadata.url}}">
            {{#if metadata.logo}}
              <img src="{{metadata.logo}}" alt="{{metadata.title}}">
            {{else}}
              {{metadata.title}}
            {{/if}}
          </a>
        </div>
        <button class="gh-search gh-icon-btn" aria-label="Search this site" data-ghost-search>{{> "icons/search"}}</button>
        <button class="gh-burger" aria-label="Toggle menu"></button>
      </div>

      <nav class="gh-head-menu">
        <ul class="nav">
          {{#each metadata.navigation}}
            <li class="nav-{{this.slug}}{{#if (isCurrent @root.page.url this.url)}} nav-current{{/if}}"><a href="{{this.url}}">{{this.label}}</a></li>
          {{/each}}
        </ul>
        <button class="gh-search gh-icon-btn" aria-label="Search this site" data-ghost-search>{{> "icons/search"}}</button>
      </nav>

      <div class="gh-head-actions">
        <button class="gh-search gh-icon-btn" aria-label="Search this site" data-ghost-search>{{> "icons/search"}}</button>
      </div>
    </div>
  </header>

  <main id="site-main" class="site-main">
    {{{ content }}}
  </main>

  <footer class="gh-foot{{#unless metadata.secondaryNavigation}} no-menu{{/unless}} gh-outer">
    <div class="gh-foot-inner gh-inner">
      <div class="gh-copyright">
        {{metadata.title}} © {{year page.date}}
      </div>
      {{#if metadata.secondaryNavigation}}
        <nav class="gh-foot-menu">
          <ul class="nav">
            {{#each metadata.secondaryNavigation}}
              <li class="nav-{{this.slug}}{{#if (isCurrent @root.page.url this.url)}} nav-current{{/if}}"><a href="{{this.url}}">{{this.label}}</a></li>
            {{/each}}
          </ul>
        </nav>
      {{/if}}
      <div class="gh-powered-by">
        <a href="https://ghost.org/" target="_blank" rel="noopener">Powered by Ghost</a>
      </div>
    </div>
  </footer>

</div>

<script src="/assets/built/main.min.js"></script>

</body>
</html>
